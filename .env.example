# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Required only by the trusted Node embedding worker. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Required only when using Telegram. Legacy Supabase HS256 JWT signing secret,
# server-only; used to mint short-lived authenticated JWTs for user-RLS search.
# SUPABASE_JWT_SECRET=

# Optional Telegram video-search bot. Pair Telegram accounts from the signed-in library.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# RECALL_TELEGRAM_WORKER_SECRET=replace-with-a-random-32-byte-secret
# RECALL_TELEGRAM_APP_URL=http://127.0.0.1:3001
# Conservative initial filters; tune using labeled queries from your own library.
# Similarity applies only to EmbeddingGemma vectors, never legacy Nomic vectors.
RECALL_TELEGRAM_MIN_SIMILARITY=0.63
RECALL_TELEGRAM_MIN_KEYWORD_RANK=2.5
RECALL_TELEGRAM_MAX_RESULTS=3

# Optional: set this to the deployed site origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Nomic embeddings through Ollama. Used only when explicitly rolling back.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_WORKER_POLL_MS=1500

# Local video upload and processing (Stage 3). Files are private and git-ignored.
RECALL_MEDIA_DIR=.local-media
RECALL_VIDEO_MAX_BYTES=104857600
RECALL_VIDEO_MAX_DURATION_SECONDS=600

# Experimental URL-to-video retrieval. Disabled by default; local development only.
RECALL_YTDLP_ENABLED=false
MEDIA_RETRIEVAL_PROVIDER=yt-dlp
YTDLP_PATH=yt-dlp
# Optional macOS Homebrew Expat fix; only passed to the yt-dlp child process.
# YTDLP_DYLD_LIBRARY_PATH=/opt/homebrew/opt/expat/lib
YTDLP_TIMEOUT_MS=900000
MEDIA_RETRIEVAL_WORKER_POLL_MS=2000
VIDEO_WORKER_POLL_MS=2000
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TESSERACT_BIN=tesseract
WHISPER_CPP_BIN=whisper-cli
# Download a multilingual whisper.cpp model file (for example ggml-base.bin).
WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.bin
WHISPER_LANGUAGE=auto
# CPU is the reliable default; set true only after confirming the local Metal path works.
WHISPER_USE_GPU=false
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=60
VIDEO_OCR_LANGUAGE=eng
VIDEO_OCR_PSM=6
VIDEO_OCR_MIN_CONFIDENCE=90
VIDEO_OCR_MIN_WORD_HEIGHT=24
VIDEO_OCR_DEBUG=false
# Optional local Ollama vision model, for example llava:7b. Leave blank to disable.
OLLAMA_VISION_MODEL=
VIDEO_MAX_VISION_FRAMES=8
# Optional local title/notes/tag generation after media is retrieved or uploaded.
# Set this to a vision-language model already installed in local Ollama.
OLLAMA_METADATA_MODEL=
OLLAMA_METADATA_NUM_CTX=8192
VIDEO_METADATA_TRANSCRIPTION_ENABLED=true
VIDEO_METADATA_SAMPLE_INTERVAL_SECONDS=4
VIDEO_METADATA_MAX_FRAMES=24
VIDEO_METADATA_FRAMES_PER_SEGMENT=4
VIDEO_METADATA_SCENE_THRESHOLD=0.32
VIDEO_METADATA_FRAME_WIDTH=768
VIDEO_METADATA_SCENE_TIMEOUT_MS=300000
VIDEO_METADATA_TOOL_TIMEOUT_MS=300000
VIDEO_METADATA_MAX_FILE_BYTES=104857600
VIDEO_METADATA_MAX_DURATION_SECONDS=600
WHISPER_TIMEOUT_MS=900000
OLLAMA_METADATA_SEGMENT_TIMEOUT_MS=180000
OLLAMA_METADATA_TIMEOUT_MS=180000
METADATA_WORKER_POLL_MS=2000
# Optional exact-text verification, using only local Ollama; defaults off.
VIDEO_OCR_VISION_VERIFY=false
VIDEO_MAX_OCR_VISION_FRAMES=8

# Primary semantic search and multimodal indexing through local Sentence Transformers.
# This is the default; Nomic remains isolated for explicit rollback only.
RECALL_SEARCH_PROVIDER=embeddinggemma2
EMBEDDINGGEMMA_URL=http://127.0.0.1:11601
EMBEDDINGGEMMA_PORT=11601
# Generate a random local-only token. This is server-side; never use NEXT_PUBLIC_.
EMBEDDINGGEMMA_TOKEN=replace-with-a-long-random-local-token
HF_HOME=.huggingface-cache
EG2_DEVICE=auto
EG2_CPU_THREADS=4
EG2_SEGMENT_SECONDS=30
EG2_VIDEO_SAMPLE_FPS=0.5
EG2_VIDEO_MAX_FRAMES=8
EG2_MAX_VIDEO_SECONDS=180
EG2_MAX_FILE_BYTES=104857600
EG2_REQUEST_TIMEOUT_MS=1200000
MULTIMODAL_WORKER_POLL_MS=1500
# Direct EmbeddingGemma 2 video/audio indexing is the normal path.
# Opt in only when exact transcripts or OCR text are useful.
VIDEO_TRANSCRIPTION_ENABLED=false
VIDEO_OCR_ENABLED=false

# Optional alternative provider; only needed with EMBEDDING_PROVIDER=openai.
# OPENAI_API_KEY=
