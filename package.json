{
  "name": "recall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node scripts/embeddinggemma2-worker.mjs",
    "worker:nomic": "node scripts/embedding-worker.mjs",
    "worker:video": "node scripts/video-worker.mjs",
    "worker:metadata": "node scripts/video-metadata-worker.mjs",
    "worker:video:ocr-debug": "node scripts/video-worker.mjs --diagnose-ocr",
    "worker:retrieval": "node scripts/media-retrieval-worker.mjs",
    "worker:retrieval:diagnose": "node scripts/media-retrieval-worker.mjs --diagnose",
    "worker:multimodal": "node scripts/embeddinggemma2-worker.mjs",
    "embeddinggemma:service": ".venv-embeddinggemma/bin/python scripts/embeddinggemma2-service.py",
    "embeddinggemma:benchmark": ".venv-embeddinggemma/bin/python scripts/embeddinggemma2-benchmark.py",
    "test:embeddinggemma": ".venv-embeddinggemma/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
